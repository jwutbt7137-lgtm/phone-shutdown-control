# 统一换行符，避免 Windows/Linux 之间产生无意义 diff
* text=auto

# Windows 批处理必须是 CRLF，否则 cmd 解析标签会出问题
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.py    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.ps1   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf

*.apk   binary
*.png   binary
*.jar   binary
